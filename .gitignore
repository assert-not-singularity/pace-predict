# Data — activity files contain personal GPS/health data; never commit
/data/*
!/data/README.md

# Belt-and-suspenders: never commit activity exports anywhere in the tree
# (case-insensitive classes also cover .Fit/.TCX/etc. on case-sensitive filesystems)
*.[Ff][Ii][Tt]
*.[Tt][Cc][Xx]
*.[Gg][Pp][Xx]

# Model artifacts
models/
*.pkl
*.joblib
*.onnx

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*

# Claude Code machine-local settings (personal permissions)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
